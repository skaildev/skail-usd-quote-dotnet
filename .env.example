# Copy to .env and fill in. .env is ignored by git (it holds secrets); only this example is versioned.
#   cp .env.example .env

# --- skail ----------------------------------------------------------------------------------------
# All four values come from your environment in the skail portal (Environments / Workloads).
#
# name:version of the workload this worker serves. It must be exactly the name:version registered
# in the skail portal (create the workload there first), otherwise the function is never delivered.
SKAIL_WORKLOAD=usdquote:v1.0.0
# Namespace and key of your skail environment. The namespace is shown as <tenant>/<environment> and the
# key is the environment key. The key is sensitive: never commit it, keep it only in .env.
SKAIL_NAMESPACE=<tenant>/<environment>
SKAIL_KEY=<environment-key-from-the-skail-portal>
# Address of the skail server (sidecar) the worker connects to, as shown for your environment.
SKAIL_SIDECAR=<skail-server-address-from-the-skail-portal>
# Address the web app uses to call the skail HTTP API (trigger and fire). It has the same value as SKAIL_SIDECAR
# (the worker uses that one); they are separate variables only to make clear what each side uses.
SKAIL_BASE_URL=<skail-server-address-from-the-skail-portal>

# --- runtime tuning -------------------------------------------------------------------------------
SKAIL_RUNTIME_LOG_LEVEL=Information
SKAIL_LOG_LEVEL=Information
SKAIL_MAX_PARALLEL_TASKS=500
SKAIL_DISABLE_REMAP=true
SKAIL_DISABLE_SCALE=true
SKAIL_LOG_TO_CONSOLE_ONLY=false
SKAIL_SEND_TELEMETRY=true

# --- this demo ------------------------------------------------------------------------------------
# where the worker reports progress (container name on the usd-quote network)
WEB_BASE_URL=http://usd-quote-web:8080
# host port of the front end
WEB_PORT=8080
# http (AwesomeAPI) or fake (offline, deterministic)
QUOTE_PROVIDER=http
QUOTE_API_URL=https://economia.awesomeapi.com.br/
