# Copy to .env and fill in. .env is ignored by git; only this example is versioned.
#   cp .env.example .env
# The values come from your environment in the skail portal (Environments & keys > Connect).

# name:version of the workload, exactly as registered in the portal. If it does not match,
# the run is never delivered to this app.
SKAIL_WORKLOAD=usdquote:v1.0.0
# Namespace (tenant/environment) and key of the environment. The key is a secret: keep it only in .env.
SKAIL_NAMESPACE=<tenant>/<environment>
SKAIL_KEY=<environment-key>
# Address of the environment. The worker connects to it, and the app starts and stops runs through its HTTP API.
SKAIL_SIDECAR=<skail-address>
# Optional: base URL of the skail HTTP API, without /api/v1. Defaults to SKAIL_SIDECAR.
# SKAIL_BASE_URL=
